# Spec 016 — e2e config. Sourced directly into the shell by
# `npm run test:e2e:build` (NOT Expo's own NODE_ENV=test mode-file loading —
# `expo export` force-overrides NODE_ENV to 'production' and ignores it, so
# that mechanism can't be used here). Values set this way become real
# process env vars before `expo export` runs, and `@expo/env` never
# overwrites an already-set system env var — so these win over `.env`
# without risking the reverse: a real `npx expo export` (no sourcing step)
# never reads this file at all, so production deploys can't be affected by
# it. Every value here is a fake/demo placeholder, safe to commit: the app
# is pointed at the local Firebase emulator suite
# (EXPO_PUBLIC_USE_FIREBASE_EMULATOR), never at a real project, and the
# emulator doesn't validate these against anything real — only
# EXPO_PUBLIC_FIREBASE_PROJECT_ID has to match the `--project` flag the
# emulators are started with (`demo-da2`).
EXPO_PUBLIC_USE_FIREBASE_EMULATOR=true
EXPO_PUBLIC_FIREBASE_API_KEY=demo-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-da2.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=demo-da2
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-da2.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
EXPO_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=demo-google-client-id
