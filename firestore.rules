rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Spec 014: an authenticated-but-unverified email/password account is
    // treated the same as signed-out everywhere. Google (and later Apple)
    // sign-ins always carry `email_verified: true` on their ID token, so
    // this is a no-op for every account this app already has.
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function uid() {
      return request.auth.uid;
    }
    // Spec 015 — stands in for the co-parent's uid on solo-period records
    // (settlements). Never a real uid, so it can never equal uid(); rejected
    // below if it ever appears in parentIds.
    function absentCoParent() {
      return '__coparent__';
    }
    function solo(id) {
      return household(id).parentIds.size() == 1;
    }
    function inviteCode(code) {
      return get(/databases/$(database)/documents/inviteCodes/$(code)).data;
    }
    function household(id) {
      return get(/databases/$(database)/documents/households/$(id)).data;
    }
    function myProfile() {
      return get(/databases/$(database)/documents/users/$(uid())).data;
    }
    // Optional-field readers: profiles created by spec 001 (before spec 002)
    // have no `joinedVia` key, and `householdId` may be absent too — reading a
    // missing key directly raises an error, so always go through these.
    function householdIdOf(data) {
      return data.get('householdId', null);
    }
    function joinedViaOf(data) {
      return data.get('joinedVia', null);
    }
    function inHousehold() {
      return exists(/databases/$(database)/documents/users/$(uid()))
        && householdIdOf(myProfile()) != null;
    }

    // ---- users/{userId} — spec 001 (own profile) + spec 002 (household link) ----
    match /users/{userId} {
      allow get: if signedIn() && (
        userId == uid() ||
        (
          householdIdOf(resource.data) != null
          && inHousehold()
          && householdIdOf(resource.data) == householdIdOf(myProfile())
        )
      );
      allow list: if false;

      // spec 001 — create your own profile; household fields start null/absent.
      allow create: if signedIn()
        && userId == uid()
        && householdIdOf(request.resource.data) == null
        && joinedViaOf(request.resource.data) == null;

      // spec 002 — only householdId / joinedVia may change, only on your own
      // doc, only in the shapes the Claim / Link steps produce.
      allow update: if signedIn()
        && userId == uid()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['householdId', 'joinedVia'])
        && identityUnchanged()
        && validProfileTransition();

      allow delete: if false;

      function identityUnchanged() {
        return request.resource.data.displayName == resource.data.displayName
          && request.resource.data.email == resource.data.email
          && request.resource.data.photoUrl == resource.data.photoUrl;
      }

      function validProfileTransition() {
        let beforeHid = householdIdOf(resource.data);
        let afterHid = householdIdOf(request.resource.data);
        let afterVia = joinedViaOf(request.resource.data);
        return
          // Claim step 2: record the code I just redeemed; household stays
          // null. `joinedVia` may be re-pointed (an earlier abandoned attempt
          // could have left a stale value) as long as the new code is one
          // this user has redeemed.
          (
            afterHid == null
            && afterVia != null
            && inviteCode(afterVia).redeemedBy == uid()
          )
          ||
          // Link / launch-repair: point householdId at the household my
          // redeemed code belongs to.
          (
            afterVia != null
            && afterHid != null
            && inviteCode(afterVia).redeemedBy == uid()
            && afterHid == inviteCode(afterVia).householdId
          )
          ||
          // Creator linking the household they just created.
          (
            beforeHid == null
            && afterHid != null
            && afterVia == null
            && household(afterHid).parentIds.size() == 1
            && household(afterHid).parentIds[0] == uid()
          );
      }
    }

    // ---- households/{householdId} — spec 002 ----
    match /households/{householdId} {
      allow get: if signedIn() && uid() in resource.data.parentIds;
      allow list: if false;

      allow create: if signedIn()
        && request.resource.data.createdBy == uid()
        && request.resource.data.parentIds.size() == 1
        && request.resource.data.parentIds[0] == uid()
        && request.resource.data.children is list
        && request.resource.data.children.size() >= 1
        && request.resource.data.pendingInviteCode is string
        // Spec 015 fields start unset; set later via setCoParentName() /
        // secondParentJoins() so there's exactly one place each is written.
        && request.resource.data.coParentName == null
        && request.resource.data.coParentJoinedAt == null
        && !inHousehold();

      allow update: if signedIn()
        && (regenerateCode() || secondParentJoins() || setTimezone() || setCoParentName());

      allow delete: if false;

      // spec 004 — a member sets the household timezone (IANA string).
      function setTimezone() {
        return uid() in resource.data.parentIds
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['timezone'])
          && request.resource.data.timezone is string;
      }

      function regenerateCode() {
        return resource.data.parentIds.size() == 1
          && resource.data.parentIds[0] == uid()
          && request.resource.data.parentIds == resource.data.parentIds
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pendingInviteCode'])
          && request.resource.data.pendingInviteCode is string;
      }

      function secondParentJoins() {
        return resource.data.parentIds.size() == 1
          && request.resource.data.parentIds.size() == 2
          && request.resource.data.parentIds[0] == resource.data.parentIds[0]
          && request.resource.data.parentIds[1] == uid()
          && request.resource.data.parentIds[1] != absentCoParent() // spec 015, criterion 9
          && request.resource.data.pendingInviteCode == null
          && request.resource.data.coParentJoinedAt is timestamp
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['parentIds', 'pendingInviteCode', 'coParentJoinedAt'])
          && resource.data.pendingInviteCode != null
          && inviteCode(resource.data.pendingInviteCode).redeemedBy == uid();
      }

      // Spec 015 — the solo parent names the absent side ("Cristián"); only
      // while solo, so it can't be used to rewrite who the real co-parent is
      // once one has joined.
      function setCoParentName() {
        return resource.data.parentIds.size() == 1
          && resource.data.parentIds[0] == uid()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['coParentName'])
          && request.resource.data.coParentName is string;
      }
    }

    // ---- inviteCodes/{code} — spec 002 (code is the document id) ----
    match /inviteCodes/{code} {
      // Any signed-in user may fetch ONE code by id (needed to redeem it);
      // listing the collection is denied so codes can't be enumerated.
      allow get: if signedIn();
      allow list: if false;

      allow create: if signedIn()
        && request.resource.data.createdBy == uid()
        && request.resource.data.redeemedBy == null
        && request.resource.data.householdId is string;

      // Redeem: set redeemedBy to your own uid, once, while the target
      // household still has exactly one parent.
      allow update: if signedIn()
        && resource.data.redeemedBy == null
        && request.resource.data.redeemedBy == uid()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['redeemedBy'])
        && household(resource.data.householdId).parentIds.size() == 1;

      // Deleted only during regenerate, by the household's sole parent.
      allow delete: if signedIn()
        && household(resource.data.householdId).parentIds.size() == 1
        && household(resource.data.householdId).parentIds[0] == uid();
    }

    // ---- households/{hid}/proposals/{proposalId} — spec 004 ----
    // Custody pattern + day-override proposals. The approved proposal IS the
    // record; the calendar is computed from a live query over this collection.
    match /households/{hid}/proposals/{proposalId} {
      function member() {
        return signedIn() && uid() in household(hid).parentIds;
      }

      allow read: if member();

      allow create: if member()
        && request.resource.data.proposerId == uid()
        && request.resource.data.acknowledgedBy == null
        && (
          // The normal, two-parent path: always starts pending.
          (
            request.resource.data.status == 'pending'
            && request.resource.data.resolvedBy == null
          )
          ||
          // Spec 015 — a solo household self-approves at creation; there is
          // nobody else to wait on. Impossible once a second parent has
          // joined (resolveProposal() below still requires a DIFFERENT uid).
          (
            solo(hid)
            && request.resource.data.status == 'approved'
            && request.resource.data.resolvedBy == uid()
          )
        )
        && (
          (
            request.resource.data.type == 'pattern'
            && request.resource.data.cycle is list
            && (request.resource.data.cycle.size() == 7 || request.resource.data.cycle.size() == 14)
            && request.resource.data.anchorDate is string
            && request.resource.data.changeoverTime is string
            && request.resource.data.effectiveFrom is string
          )
          ||
          (
            request.resource.data.type == 'day-override'
            && request.resource.data.date is string
            && request.resource.data.assignedTo in [0, 1]
          )
        );

      allow update: if member() && (resolveProposal() || cancelProposal() || acknowledgeProposal());
      allow delete: if false;

      // Only the NON-proposing parent approves / rejects (criterion 5). Note
      // this alone can never fire in a solo household — there is no second
      // member() — so it can't be used to bypass the create-time rule above.
      function resolveProposal() {
        return resource.data.proposerId != uid()
          && resource.data.status == 'pending'
          && request.resource.data.status in ['approved', 'rejected']
          && request.resource.data.resolvedBy == uid()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'resolvedAt', 'resolvedBy']);
      }

      // The proposer cancels while still pending.
      function cancelProposal() {
        return resource.data.proposerId == uid()
          && resource.data.status == 'pending'
          && request.resource.data.status == 'cancelled'
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'resolvedAt']);
      }

      // Spec 015 — a newly-joined co-parent accepts a decision the solo
      // parent made unilaterally (resolvedBy == proposerId is only possible
      // via the solo create-time branch above). Only the OTHER parent can
      // acknowledge — never the one who made it — and only once.
      function acknowledgeProposal() {
        return household(hid).parentIds.size() == 2
          && resource.data.resolvedBy == resource.data.proposerId
          && uid() != resource.data.proposerId
          && resource.data.acknowledgedBy == null
          && request.resource.data.acknowledgedBy == uid()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['acknowledgedBy']);
      }
    }

    // ---- households/{hid}/events/{eventId} — spec 005 ----
    match /households/{hid}/events/{eventId} {
      function member() {
        return signedIn() && uid() in household(hid).parentIds;
      }
      function validType(data) {
        return data.type in ['doctor', 'birthday', 'tournament', 'training', 'school', 'other'];
      }
      // Recurrence is allowed only on training events, weekly, with an end date.
      function validRecurrence(data) {
        return data.recurrence == null
          || (
            data.type == 'training'
            && data.recurrence.freq == 'weekly'
            && data.recurrence.until is string
          );
      }

      allow read: if member();

      allow create: if member()
        && request.resource.data.createdBy == uid()
        && request.resource.data.updatedBy == uid()
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.date is string
        && validType(request.resource.data)
        && validRecurrence(request.resource.data);

      allow update: if member()
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedBy == uid()
        && validType(request.resource.data)
        && validRecurrence(request.resource.data);

      allow delete: if member();
    }

    // ---- households/{hid}/receipts/{receiptId} — spec 003 ----
    // Private to the uploader by default; sharing is a one-way, one-field flip.
    match /households/{hid}/receipts/{receiptId} {
      function member() {
        return signedIn() && uid() in household(hid).parentIds;
      }

      allow read: if member()
        && (resource.data.uploaderId == uid() || resource.data.visibility == 'shared');

      allow create: if member()
        && request.resource.data.uploaderId == uid()
        && request.resource.data.visibility == 'private'
        && request.resource.data.sharedAt == null
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.currency is string
        && request.resource.data.tags is list
        && request.resource.data.tags.hasOnly(['tuition', 'medical', 'sports', 'clothing', 'other'])
        && request.resource.data.tags.toSet().size() == request.resource.data.tags.size()
        && request.resource.data.expenseDate is string
        && request.resource.data.fileType in ['image', 'pdf']
        && request.resource.data.storagePath is string;

      // The ONLY legal update: flip private → shared, freezing the spec-010
      // split % in the same write (criterion 7 + spec 010).
      allow update: if member()
        && resource.data.uploaderId == uid()
        && resource.data.visibility == 'private'
        && request.resource.data.visibility == 'shared'
        && request.resource.data.sharedAt != null
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['visibility', 'sharedAt', 'splitPercentA'])
        && request.resource.data.splitPercentA is number
        && request.resource.data.splitPercentA >= 0
        && request.resource.data.splitPercentA <= 100;

      allow delete: if member()
        && resource.data.uploaderId == uid()
        && resource.data.visibility == 'private';
    }

    // ---- households/{hid}/splitProposals/{proposalId} — spec 010 ----
    // The expense-split table, agreed like custody: the newest approved
    // proposal is the active table.
    match /households/{hid}/splitProposals/{proposalId} {
      function member() {
        return signedIn() && uid() in household(hid).parentIds;
      }

      allow read: if member();

      allow create: if member()
        && request.resource.data.proposerId == uid()
        && request.resource.data.acknowledgedBy == null
        && (
          (
            request.resource.data.status == 'pending'
            && request.resource.data.resolvedBy == null
          )
          ||
          // Spec 015 — solo self-approval at creation, same as custody.
          (
            solo(hid)
            && request.resource.data.status == 'approved'
            && request.resource.data.resolvedBy == uid()
          )
        )
        && request.resource.data.defaultPercentA is number
        && request.resource.data.defaultPercentA >= 0
        && request.resource.data.defaultPercentA <= 100
        && request.resource.data.overrides is map;

      allow update: if member() && (resolveSplit() || cancelSplit() || acknowledgeSplit());
      allow delete: if false;

      // Only the NON-proposing parent approves / rejects.
      function resolveSplit() {
        return resource.data.proposerId != uid()
          && resource.data.status == 'pending'
          && request.resource.data.status in ['approved', 'rejected']
          && request.resource.data.resolvedBy == uid()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'resolvedAt', 'resolvedBy']);
      }
      function cancelSplit() {
        return resource.data.proposerId == uid()
          && resource.data.status == 'pending'
          && request.resource.data.status == 'cancelled'
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'resolvedAt']);
      }
      // Spec 015 — see acknowledgeProposal() on households/{hid}/proposals.
      function acknowledgeSplit() {
        return household(hid).parentIds.size() == 2
          && resource.data.resolvedBy == resource.data.proposerId
          && uid() != resource.data.proposerId
          && resource.data.acknowledgedBy == null
          && request.resource.data.acknowledgedBy == uid()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['acknowledgedBy']);
      }
    }

    // ---- households/{hid}/settlements/{settlementId} — spec 010 ----
    // A recorded payment; pending until the OTHER parent confirms.
    match /households/{hid}/settlements/{settlementId} {
      function member() {
        return signedIn() && uid() in household(hid).parentIds;
      }

      allow read: if member();

      allow create: if member()
        && request.resource.data.recordedBy == uid()
        && request.resource.data.payerUid != request.resource.data.payeeUid
        && (
          // The normal, two-parent path: both real parents, starts pending.
          (
            request.resource.data.payerUid in household(hid).parentIds
            && request.resource.data.payeeUid in household(hid).parentIds
            && request.resource.data.status == 'pending'
            && request.resource.data.resolvedBy == null
          )
          ||
          // Spec 015 — solo: one side is the absent-co-parent sentinel (never
          // a real parentIds member, so the branch above can't match it), and
          // there's nobody else to confirm, so it's self-confirmed immediately.
          (
            solo(hid)
            && request.resource.data.status == 'confirmed'
            && request.resource.data.resolvedBy == uid()
            && (
              (request.resource.data.payerUid == uid()
                && request.resource.data.payeeUid == absentCoParent())
              ||
              (request.resource.data.payerUid == absentCoParent()
                && request.resource.data.payeeUid == uid())
            )
          )
        )
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.currency is string;

      allow update: if member() && (confirmSettlement() || cancelSettlement());
      allow delete: if false;

      // Only the parent who did NOT record it confirms / rejects.
      function confirmSettlement() {
        return resource.data.recordedBy != uid()
          && resource.data.status == 'pending'
          && request.resource.data.status in ['confirmed', 'rejected']
          && request.resource.data.resolvedBy == uid()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'resolvedAt', 'resolvedBy']);
      }
      function cancelSettlement() {
        return resource.data.recordedBy == uid()
          && resource.data.status == 'pending'
          && request.resource.data.status == 'cancelled'
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'resolvedAt']);
      }
    }

    // Everything else is added spec-by-spec; default deny until then.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
