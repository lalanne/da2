rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function uid() {
      return request.auth.uid;
    }
    function inviteCode(code) {
      return get(/databases/$(database)/documents/inviteCodes/$(code)).data;
    }
    function household(id) {
      return get(/databases/$(database)/documents/households/$(id)).data;
    }
    function myProfile() {
      return get(/databases/$(database)/documents/users/$(uid())).data;
    }
    // Optional-field readers: profiles created by spec 001 (before spec 002)
    // have no `joinedVia` key, and `householdId` may be absent too — reading a
    // missing key directly raises an error, so always go through these.
    function householdIdOf(data) {
      return data.get('householdId', null);
    }
    function joinedViaOf(data) {
      return data.get('joinedVia', null);
    }
    function inHousehold() {
      return exists(/databases/$(database)/documents/users/$(uid()))
        && householdIdOf(myProfile()) != null;
    }

    // ---- users/{userId} — spec 001 (own profile) + spec 002 (household link) ----
    match /users/{userId} {
      allow get: if signedIn() && (
        userId == uid() ||
        (
          householdIdOf(resource.data) != null
          && inHousehold()
          && householdIdOf(resource.data) == householdIdOf(myProfile())
        )
      );
      allow list: if false;

      // spec 001 — create your own profile; household fields start null/absent.
      allow create: if signedIn()
        && userId == uid()
        && householdIdOf(request.resource.data) == null
        && joinedViaOf(request.resource.data) == null;

      // spec 002 — only householdId / joinedVia may change, only on your own
      // doc, only in the shapes the Claim / Link steps produce.
      allow update: if signedIn()
        && userId == uid()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['householdId', 'joinedVia'])
        && identityUnchanged()
        && validProfileTransition();

      allow delete: if false;

      function identityUnchanged() {
        return request.resource.data.displayName == resource.data.displayName
          && request.resource.data.email == resource.data.email
          && request.resource.data.photoUrl == resource.data.photoUrl;
      }

      function validProfileTransition() {
        let beforeHid = householdIdOf(resource.data);
        let afterHid = householdIdOf(request.resource.data);
        let afterVia = joinedViaOf(request.resource.data);
        return
          // Claim step 2: record the code I just redeemed; household stays
          // null. `joinedVia` may be re-pointed (an earlier abandoned attempt
          // could have left a stale value) as long as the new code is one
          // this user has redeemed.
          (
            afterHid == null
            && afterVia != null
            && inviteCode(afterVia).redeemedBy == uid()
          )
          ||
          // Link / launch-repair: point householdId at the household my
          // redeemed code belongs to.
          (
            afterVia != null
            && afterHid != null
            && inviteCode(afterVia).redeemedBy == uid()
            && afterHid == inviteCode(afterVia).householdId
          )
          ||
          // Creator linking the household they just created.
          (
            beforeHid == null
            && afterHid != null
            && afterVia == null
            && household(afterHid).parentIds.size() == 1
            && household(afterHid).parentIds[0] == uid()
          );
      }
    }

    // ---- households/{householdId} — spec 002 ----
    match /households/{householdId} {
      allow get: if signedIn() && uid() in resource.data.parentIds;
      allow list: if false;

      allow create: if signedIn()
        && request.resource.data.createdBy == uid()
        && request.resource.data.parentIds.size() == 1
        && request.resource.data.parentIds[0] == uid()
        && request.resource.data.children is list
        && request.resource.data.children.size() >= 1
        && request.resource.data.pendingInviteCode is string
        && !inHousehold();

      allow update: if signedIn()
        && (regenerateCode() || secondParentJoins() || setTimezone());

      allow delete: if false;

      // spec 004 — a member sets the household timezone (IANA string).
      function setTimezone() {
        return uid() in resource.data.parentIds
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['timezone'])
          && request.resource.data.timezone is string;
      }

      function regenerateCode() {
        return resource.data.parentIds.size() == 1
          && resource.data.parentIds[0] == uid()
          && request.resource.data.parentIds == resource.data.parentIds
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pendingInviteCode'])
          && request.resource.data.pendingInviteCode is string;
      }

      function secondParentJoins() {
        return resource.data.parentIds.size() == 1
          && request.resource.data.parentIds.size() == 2
          && request.resource.data.parentIds[0] == resource.data.parentIds[0]
          && request.resource.data.parentIds[1] == uid()
          && request.resource.data.pendingInviteCode == null
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['parentIds', 'pendingInviteCode'])
          && resource.data.pendingInviteCode != null
          && inviteCode(resource.data.pendingInviteCode).redeemedBy == uid();
      }
    }

    // ---- inviteCodes/{code} — spec 002 (code is the document id) ----
    match /inviteCodes/{code} {
      // Any signed-in user may fetch ONE code by id (needed to redeem it);
      // listing the collection is denied so codes can't be enumerated.
      allow get: if signedIn();
      allow list: if false;

      allow create: if signedIn()
        && request.resource.data.createdBy == uid()
        && request.resource.data.redeemedBy == null
        && request.resource.data.householdId is string;

      // Redeem: set redeemedBy to your own uid, once, while the target
      // household still has exactly one parent.
      allow update: if signedIn()
        && resource.data.redeemedBy == null
        && request.resource.data.redeemedBy == uid()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['redeemedBy'])
        && household(resource.data.householdId).parentIds.size() == 1;

      // Deleted only during regenerate, by the household's sole parent.
      allow delete: if signedIn()
        && household(resource.data.householdId).parentIds.size() == 1
        && household(resource.data.householdId).parentIds[0] == uid();
    }

    // ---- households/{hid}/proposals/{proposalId} — spec 004 ----
    // Custody pattern + day-override proposals. The approved proposal IS the
    // record; the calendar is computed from a live query over this collection.
    match /households/{hid}/proposals/{proposalId} {
      function member() {
        return signedIn() && uid() in household(hid).parentIds;
      }

      allow read: if member();

      allow create: if member()
        && request.resource.data.proposerId == uid()
        && request.resource.data.status == 'pending'
        && request.resource.data.resolvedBy == null
        && (
          (
            request.resource.data.type == 'pattern'
            && request.resource.data.cycle is list
            && (request.resource.data.cycle.size() == 7 || request.resource.data.cycle.size() == 14)
            && request.resource.data.anchorDate is string
            && request.resource.data.changeoverTime is string
            && request.resource.data.effectiveFrom is string
          )
          ||
          (
            request.resource.data.type == 'day-override'
            && request.resource.data.date is string
            && request.resource.data.assignedTo in [0, 1]
          )
        );

      allow update: if member() && (resolveProposal() || cancelProposal());
      allow delete: if false;

      // Only the NON-proposing parent approves / rejects (criterion 5).
      function resolveProposal() {
        return resource.data.proposerId != uid()
          && resource.data.status == 'pending'
          && request.resource.data.status in ['approved', 'rejected']
          && request.resource.data.resolvedBy == uid()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'resolvedAt', 'resolvedBy']);
      }

      // The proposer cancels while still pending.
      function cancelProposal() {
        return resource.data.proposerId == uid()
          && resource.data.status == 'pending'
          && request.resource.data.status == 'cancelled'
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'resolvedAt']);
      }
    }

    // Everything else is added spec-by-spec; default deny until then.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
