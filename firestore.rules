rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // spec 001 — a user reads/writes only their own profile.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Everything else is added spec-by-spec; default deny until then.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
